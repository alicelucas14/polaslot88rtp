RewriteOptions inherit

RewriteEngine on
DirectoryIndex index.php
Options All -Indexes

# --- Admin Subdomain Routing ---
# 1. Route admin.polaslot88rtp.cam directly to the admin panel
RewriteCond %{HTTP_HOST} ^admin\.polaslot88rtp\.cam$ [NC]
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_URI} !^/images/
RewriteRule ^(.*)$ admin/$1 [L]

# 2. Redirect polaslot88rtp.cam/admin to https://admin.polaslot88rtp.cam
RewriteCond %{HTTP_HOST} ^(www\.)?polaslot88rtp\.cam$ [NC]
RewriteRule ^admin(/.*)?$ https://admin.polaslot88rtp.cam$1 [R=301,L]

# Protect sensitive files, logs, and environments
<FilesMatch "^(error_log|\.env|\.git|\.user\.ini|\.ht)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Enable Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Enable Gzip compression if Apache mod_deflate is active
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

RewriteCond %{HTTP_HOST} ^rtppolaslot88\.fun$ [OR]
RewriteCond %{HTTP_HOST} ^www\.rtppolaslot88\.fun$
RewriteRule ^(.*)$ "http\:\/\/polaslot88rtp\.cfd\/$1" [R=301,L]
RewriteCond %{HTTP_HOST} ^polaslot88rtp\.vip$ [OR]
RewriteCond %{HTTP_HOST} ^www\.polaslot88rtp\.vip$
RewriteRule ^(.*)$ "https\:\/\/www\.polaslot88slotgacor\.homes\/$1" [R=301,L]
RewriteCond %{HTTP_HOST} ^polaslot88rtp\.homes$ [OR]
RewriteCond %{HTTP_HOST} ^www\.polaslot88rtp\.homes$
RewriteRule ^(.*)$ "http\:\/\/tinyurl\.com\/polaslot88\-RTP$1" [R=301,L]
RewriteCond %{HTTP_HOST} ^polaslot88rtp\.lol$ [OR]
RewriteCond %{HTTP_HOST} ^www\.polaslot88rtp\.lol$
RewriteRule ^(.*)$ "http\:\/\/polaslot88win\.yachts\/$1" [R=301,L]
